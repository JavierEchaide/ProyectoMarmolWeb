---
// IV · Proceso (V3): cuaderno de taller. Marco visual de la V3; el contenido
// se rehace en la V4. Todo el CSS propio está en public/css/sala-proceso.css.
import Base from '../layouts/Base.astro';
import Imagen from '../components/Imagen.astro';
import AntesDespues from '../components/AntesDespues.astro';
import Siguiente from '../components/Siguiente.astro';
import { proceso } from '../data/proceso.js';
import { semanas, semanaActual, bloqueActual, proximoHito } from '../lib/semanas.js';
import { registroDe, archivoRegistro } from '../lib/registros.js';
import referenciasVault from '../data/generado/referencias.json';
import cuaderno from '../data/generado/cuaderno.json';

const etiquetaEstado = { hecho: 'Hecho', 'en-curso': 'En curso', pendiente: 'Planificado' };
const estadoBloque = (ss) =>
  ss.every((s) => s.estado === 'hecho') ? 'hecho' : ss.some((s) => s.estado !== 'pendiente') ? 'en-curso' : 'pendiente';
const rango = (ss) => `${ss[0].semana} – ${ss[ss.length - 1].semana}`;
const slug = (t) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-');
const dos = (n) => String(n).padStart(2, '0');

// Estado: sale solo de los estados de las semanas (src/lib/semanas.js)
const actual = semanaActual();
const numeroActual = semanas.indexOf(actual) + 1;
const hechas = semanas.filter((s) => s.estado === 'hecho').length;
const enCurso = semanas.filter((s) => s.estado === 'en-curso').length;
const hito = proximoHito();
const abierto = bloqueActual();

// Referencias: las de proceso.js más las exportadas de Obsidian (por categoría)
const referencias = proceso.referencias.map((r) => ({
  ...r,
  items: [...r.items, ...referenciasVault.filter((v) => slug(v.categoria) === slug(r.categoria)).map((v) => ({ ...v, imagen: v.imagen ?? { src: null, alt: v.titulo, falta: `Imagen de la referencia: ${v.titulo}` } }))],
}));

const secciones = [
  { id: 'estado', titulo: 'Estado' },
  { id: 'desarrollo-visual', titulo: 'Desarrollo visual' },
  { id: 'metodo', titulo: 'Método' },
  { id: 'calendario', titulo: 'Calendario' },
  { id: 'archivo', titulo: 'Archivo' },
];

// Método: cada paso con la captura del WIP (hueco hasta que exista)
const pasos = proceso.pipeline.map((p) => ({
  ...p,
  imagen: p.imagen ?? { src: null, alt: `Captura del WIP del paso ${p.paso}.`, falta: `Captura del WIP del paso: ${p.paso}` },
}));

// Dato de render: sale de proceso.render
const render = proceso.render;

// Calendario como veta: un nodo por bloque. La veta es sinuosa: cada nodo cae
// en una posición horizontal distinta (porcentaje del ancho de la columna).
const ALTO_NODO = 200;
const equis = [16, 44, 24, 52, 20, 48, 28];
const nodos = proceso.bloques.map((b, i) => ({ b, x: equis[i % equis.length], y: ALTO_NODO * (i + 0.5) }));
const altoVeta = ALTO_NODO * nodos.length;
const trazo = nodos.reduce((d, n, i) => {
  if (i === 0) return `M ${n.x} 0 L ${n.x} ${n.y}`;
  const a = nodos[i - 1];
  return `${d} C ${a.x} ${a.y + ALTO_NODO / 2}, ${n.x} ${n.y - ALTO_NODO / 2}, ${n.x} ${n.y}`;
}, '') + ` L ${nodos.at(-1).x} ${altoVeta}`;
// Hasta dónde se enciende en rojo: el nodo del bloque actual más lo avanzado dentro de él
const iActual = proceso.bloques.indexOf(abierto);
const dentro = abierto.semanas.findIndex((s) => s.semana === actual.semana) / abierto.semanas.length;
const encendido = Math.round(((iActual + 0.5 + dentro * 0.6) / nodos.length) * 100);

// Archivo: una sola colección de piezas con su tipo y, si se sabe, su bloque
const bloqueDe = (id) => semanas.find((s) => s.id === id)?.bloque.numero ?? '';
const piezas = [
  ...proceso.archivo.wips.map((w) => ({ tipo: 'wips', bloque: bloqueDe(w.semana), titulo: w.falta, imagen: w, grupo: 'wips' })),
  ...proceso.archivo.versiones.map((v) => ({ tipo: 'versiones', bloque: bloqueDe(v.imagen?.semana), titulo: v.titulo, texto: v.texto, imagen: v.imagen, grupo: 'versiones' })),
  ...proceso.archivo.fallos.map((f) => ({ tipo: 'fallos', bloque: '', titulo: f.titulo, texto: f.texto })),
];
const tipos = [
  { id: 'wips', nombre: 'WIPs' },
  { id: 'versiones', nombre: 'Versiones' },
  { id: 'fallos', nombre: 'Fallos' },
  { id: 'cuaderno', nombre: 'Cuaderno' },
];
const nombreTipo = { wips: 'WIP', versiones: 'Versión', fallos: 'Fallo', cuaderno: 'Cuaderno' };
const bloquesConPiezas = proceso.bloques.filter((b) => piezas.some((p) => p.bloque === b.numero));
---
<Base id="proceso" descripcion="Cómo se ha hecho el teaser de Serie Mármol: estado, desarrollo visual, método, calendario y archivo." estilos={['css/sala-proceso.css']} scripts={['js/proceso.js']}>
  {/* Cabecera monumental */}
  <header class="contenedor portico">
    <span class="numeral-hueco portico__numeral" aria-hidden="true">IV</span>
    <p class="etiqueta portico__sala" data-revelar>Sala IV · Cuaderno de taller</p>
    <h1 class="monumental portico__titulo" data-revelar style="--i:1">Proceso</h1>
    <p class="portico__intro texto-largo" data-revelar style="--i:2">{proceso.intro}</p>
  </header>

  {/* Cuaderno de taller: índice lateral de placas (con scrollspy) + contenido */}
  <div class="contenedor taller">
    <nav class="placas" aria-label="Índice de Proceso" data-indice>
      <ol class="placas__lista">
        {secciones.map((sec, i) => (
          <li>
            <a class="placas__placa" href={`#${sec.id}`} data-indice-enlace>
              <span class="placas__numero" aria-hidden="true">{dos(i + 1)}</span>
              <span class="placas__nombre">{sec.titulo}</span>
            </a>
          </li>
        ))}
      </ol>
      <span class="placas__plomo" aria-hidden="true"></span>
      <span class="placas__pesa" aria-hidden="true"></span>
    </nav>

    <div class="taller__contenido">
      {/* 1 · Estado: regla graduada de 35 semanas */}
      <section class="tramo" id="estado" aria-labelledby="titulo-estado" data-indice-seccion>
        <header class="tramo__cabecera" data-revelar>
          <p class="etiqueta">Hoy</p>
          <h2 class="tramo__titulo" id="titulo-estado">Estado</h2>
        </header>
        <div class="hoy" data-revelar>
          <p class="hoy__semana">
            <span class="hoy__numero" aria-hidden="true">{dos(numeroActual)}</span>
            <span class="hoy__texto">Semana {numeroActual} de {semanas.length}.<br />{hechas} hechas, {enCurso} en curso.</span>
          </p>
          <ol class="regla" aria-label={`Regla de ${semanas.length} semanas: ${hechas} hechas`}>
            {semanas.map((s, i) => (
              <li class:list={['regla__marca', `regla__marca--${s.estado}`, { 'regla__marca--bloque': s.bloque.semanas[0].semana === s.semana, 'regla__marca--actual': s === actual }]}>
                <a href={`#${s.id.toLowerCase()}`} data-indice-semana aria-label={`Semana ${i + 1}: ${s.plan} (${etiquetaEstado[s.estado]})`} aria-current={s === actual ? 'step' : undefined}></a>
                {s.bloque.semanas[0].semana === s.semana && <span class="regla__bloque" aria-hidden="true">{s.bloque.numero}</span>}
              </li>
            ))}
          </ol>
          <p class="regla__cota" aria-hidden="true"><span>S01</span><span>{semanas.length} semanas · marca larga: empieza un bloque</span><span>S{semanas.length}</span></p>
          <dl class="hoy__datos">
            <div>
              <dt class="etiqueta">Fase en curso</dt>
              <dd>Bloque {actual.bloque.numero} · {actual.bloque.titulo}: {actual.plan.charAt(0).toLowerCase() + actual.plan.slice(1)} <a href={`#${actual.semana.toLowerCase()}`}>({actual.semana})</a></dd>
            </div>
            <div>
              <dt class="etiqueta">Último resultado</dt>
              {proceso.estado.ultimoResultado ? (
                <dd>{proceso.estado.ultimoResultado}</dd>
              ) : (
                <dd class="hoy__hueco"><span class="insignia">Placeholder</span>{proceso.estado.faltaResultado}</dd>
              )}
            </div>
            {hito && (
              <div>
                <dt class="etiqueta">Próximo hito</dt>
                <dd>{hito.plan.split('·').at(-1).trim()} · {hito.semana} ({hito.fechas})</dd>
              </div>
            )}
          </dl>
        </div>
      </section>

      {/* 2 · Desarrollo visual: antes y después grandes con anotaciones de taller */}
      <section class="tramo" id="desarrollo-visual" aria-labelledby="titulo-desarrollo" data-indice-seccion>
        <header class="tramo__cabecera" data-revelar>
          <p class="etiqueta">Antes y después</p>
          <h2 class="tramo__titulo" id="titulo-desarrollo">Desarrollo visual</h2>
        </header>
        <ul class="laminas">
          {proceso.antesDespues.map((c, i) => (
            <li class="lamina" data-revelar>
              <div class="lamina__pieza pieza">
                <AntesDespues antes={c.antes} despues={c.despues} titulo={c.titulo} />
              </div>
              <div class="lamina__nota">
                <p class="etiqueta lamina__fig">Fig. {i + 1}</p>
                <span class="lamina__filete" aria-hidden="true"></span>
                <h3 class="lamina__titulo">{c.titulo}</h3>
                <p class="lamina__texto">{c.texto}</p>
              </div>
            </li>
          ))}
        </ul>
        {proceso.desarrolloVisual.length > 0 && (
          <ul class="fichas-taller">
            {proceso.desarrolloVisual.map((d) => (
              <li class="ficha-taller" data-revelar>
                <Imagen imagen={d.imagen} ratio="4 / 3" ver grupo="desarrollo" pie={d.titulo} />
                <h3 class="lamina__titulo">{d.titulo}{d.borrador && <span class="insignia">Borrador</span>}</h3>
                <p class="lamina__texto">{d.texto}</p>
              </li>
            ))}
          </ul>
        )}
      </section>

      {/* 3 · Método: paso a paso fijado, referencias como cajones y dato de render */}
      <section class="tramo" id="metodo" aria-labelledby="titulo-metodo" data-indice-seccion>
        <header class="tramo__cabecera" data-revelar>
          <p class="etiqueta">Del guion a la entrega</p>
          <h2 class="tramo__titulo" id="titulo-metodo">Método</h2>
        </header>

        {/* Sin JS, en móvil o con movimiento reducido es una lista; con JS en
            escritorio se fija y el paso activo cambia al bajar */}
        <div class="recorrido" id="pipeline" data-metodo style={`--pasos: ${pasos.length}`}>
          <div class="recorrido__fijo">
            <ol class="estaciones">
              {pasos.map((p, i) => (
                <li class:list={['estacion', `estacion--${p.estado}`]} data-metodo-paso>
                  <div class="estacion__texto">
                    <span class="estacion__nodo" aria-hidden="true"></span>
                    <h3 class="estacion__titulo" data-metodo-titulo><span class="estacion__numero" aria-hidden="true">{dos(i + 1)}</span>{p.paso}</h3>
                    <p class="estacion__detalle">{p.texto}</p>
                    <span class={`sello sello--${p.estado}`}>{etiquetaEstado[p.estado]}</span>
                  </div>
                  <figure class="estacion__captura">
                    <Imagen imagen={p.imagen} ratio="16 / 10" ver grupo="metodo" pie={`${dos(i + 1)} · ${p.paso}`} />
                  </figure>
                </li>
              ))}
            </ol>
            <div class="recorrido__pie" aria-hidden="true">
              <p class="recorrido__contador"><span data-metodo-contador>01</span><span class="recorrido__de"> / {dos(pasos.length)}</span></p>
              <div class="recorrido__regla"><div data-metodo-regla></div></div>
            </div>
          </div>
        </div>

        <h3 class="tramo__subtitulo" id="referencias">Referencias <span class="tramo__subnota">Qué es · Qué cojo · Dónde aplica</span></h3>
        <ul class="cajones">
          {referencias.map((r, i) => (
            <li class:list={['cajon', { 'cajon--vacio': !r.items.length }]} data-revelar style={`--i: ${i % 4}`}>
              <span class="cajon__tirador" aria-hidden="true"></span>
              <h4 class="cajon__titulo">{r.categoria}</h4>
              {r.items.length > 0 ? (
                <>
                  <p class="cajon__lista">{r.items.map((it) => it.titulo).join(' · ')}</p>
                  <button class="boton cajon__abrir" type="button" data-abrir-dialogo={`ref-${slug(r.categoria)}`}>
                    Abrir {r.items.length} {r.items.length === 1 ? 'referencia' : 'referencias'}
                  </button>
                </>
              ) : (
                <p class="cajon__lista">Por documentar</p>
              )}
            </li>
          ))}
        </ul>

        {referencias.filter((r) => r.items.length).map((r) => (
          <dialog class="dialogo" id={`ref-${slug(r.categoria)}`} aria-labelledby={`ref-${slug(r.categoria)}-titulo`}>
            <div class="dialogo__cabecera">
              <p class="antetitulo">Referencias</p>
              <h3 id={`ref-${slug(r.categoria)}-titulo`} class="dialogo__titulo">{r.categoria}</h3>
              <button class="boton boton--pequeno" type="button" data-cerrar-dialogo>Cerrar</button>
            </div>
            <ul class="fichas-ref">
              {r.items.map((it) => (
                <li class="ficha-ref">
                  <Imagen imagen={it.imagen} ratio="4 / 3" ver grupo={`ref-${slug(r.categoria)}`} pie={it.titulo} />
                  <div class="ficha-ref__texto">
                    <h4 class="ficha-ref__titulo">{it.titulo}</h4>
                    <dl>
                      <dt>Qué es</dt><dd>{it.que}</dd>
                      <dt>Qué cojo</dt><dd>{it.cojo}</dd>
                      <dt>Dónde aplica</dt><dd>{it.donde}</dd>
                    </dl>
                  </div>
                </li>
              ))}
            </ul>
          </dialog>
        ))}

        <h3 class="tramo__subtitulo" id="render">Dato de render</h3>
        <div class="medida" data-revelar>
          <p class="medida__cifra">
            <strong class="medida__numero">{render.propio}</strong>
            <span class="etiqueta">por fotograma · ajustes propios</span>
          </p>
          <p class="medida__cifra medida__cifra--menor">
            <strong class="medida__numero">{render.fabrica}</strong>
            <span class="etiqueta">ajustes de fábrica</span>
          </p>
          <div class="medida__nota">
            <p class="medida__calculo">{render.calculo}</p>
            <p>{render.nota}</p>
          </div>
        </div>
      </section>

      {/* 4 · Calendario como veta luminosa: un nodo por bloque. Cada bloque es
          un <details> (teclado y estado expandido nativos); en escritorio sus
          semanas salen en un panel al lado, en móvil debajo. Solo el bloque
          actual viene abierto. Cada semana conserva su ancla (#s05). */}
      <section class="tramo" id="calendario" aria-labelledby="titulo-tiempo" data-indice-seccion>
        <header class="tramo__cabecera" data-revelar>
          <p class="etiqueta">S01 – S{semanas.length}</p>
          <h2 class="tramo__titulo" id="titulo-tiempo">Calendario</h2>
          <ul class="leyenda-veta" aria-label="Leyenda de estados">
            {Object.entries(etiquetaEstado).map(([k, v]) => <li><span class={`rombo rombo--${k}`} aria-hidden="true"></span>{v}</li>)}
          </ul>
        </header>

        <div class="calveta" data-calveta style={`--alto-nodo: ${ALTO_NODO}px; --encendido: ${encendido}; --tope: ${encendido}`}>
          <svg class="calveta__trazo" viewBox={`0 0 100 ${altoVeta}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="calveta__halo" d={trazo} />
            <path class="calveta__grafito" d={trazo} />
          </svg>
          <svg class="calveta__trazo calveta__trazo--rojo" viewBox={`0 0 100 ${altoVeta}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
            <path class="calveta__brillo" d={trazo} />
            <path class="calveta__rojo" d={trazo} />
          </svg>
          <ol class="calveta__lista">
            {nodos.map(({ b, x }) => {
              const estado = estadoBloque(b.semanas);
              return (
                <li class:list={['calveta__bloque', `calveta__bloque--${estado}`, { 'calveta__bloque--actual': b === abierto }]} style={`--x: ${x}`}>
                  <details name="calendario" open={b === abierto}>
                    <summary class="calveta__nodo">
                      <span class={`rombo rombo--${estado}`} aria-hidden="true"></span>
                      <span class="calveta__cartela">
                        <span class="etiqueta calveta__rango">Bloque {b.numero} · {rango(b.semanas)}</span>
                        <span class="calveta__titulo">{b.titulo}</span>
                        <span class="calveta__fechas">{b.fechas} · {etiquetaEstado[estado]}</span>
                        {b === abierto && <span class="calveta__ahora">Ahora · {actual.semana}</span>}
                      </span>
                    </summary>
                    <div class="calveta__panel">
                      <div class="calveta__caja">
                      <p class="etiqueta">Bloque {b.numero} · {b.titulo}</p>
                      <p class="calveta__objetivo">{b.objetivo}</p>
                      <ol class="calveta__semanas">
                        {b.semanas.map((s) => {
                          const reg = registroDe({ ...s, id: s.semana });
                          return (
                            <li class:list={['calveta__semana', `calveta__semana--${s.estado}`]} id={s.semana.toLowerCase()}>
                              <p class="calveta__cabecera">
                                <a class="calveta__numero" href={`#${s.semana.toLowerCase()}`} aria-label={`${s.semana}: enlace directo a esta semana`}>{s.semana}</a>
                                <span class="calveta__dias">{s.fechas}</span>
                                <span class={`sello sello--${s.estado}`}>{etiquetaEstado[s.estado]}</span>
                              </p>
                              <p class="calveta__plan">{s.plan}</p>
                              {s.miniatura && <Imagen imagen={s.miniatura} ratio="16 / 10" ver grupo={`bloque-${b.numero}`} pie={`${s.semana} · ${s.plan}`} />}
                              {s.registro.length > 0 && (
                                <ul class="calveta__registro">
                                  {s.registro.map((r) => <li>{r}</li>)}
                                </ul>
                              )}
                              {reg && (
                                <a class="boton calveta__ver" href={archivoRegistro({ id: s.semana })}>
                                  Ver registro<span class="oculto"> de la semana {s.semana.slice(1)}</span>
                                </a>
                              )}
                            </li>
                          );
                        })}
                      </ol>
                      {b.capturas.length > 0 && (
                        <ul class="calveta__capturas">
                          {b.capturas.map((c) => (
                            <li>
                              <Imagen imagen={c.imagen} ratio="16 / 10" ver grupo={`bloque-${b.numero}`} pie={c.titulo} />
                              <p class="calveta__plan">{c.titulo}</p>
                              <p class="calveta__dias">{c.texto}</p>
                            </li>
                          ))}
                        </ul>
                      )}
                      </div>
                    </div>
                  </details>
                </li>
              );
            })}
          </ol>
        </div>
      </section>

      {/* 5 · Archivo: colección con filtros. Sin JavaScript se ven todas las
          piezas y los filtros no aparecen. */}
      <section class="tramo" id="archivo" aria-labelledby="titulo-archivo" data-indice-seccion>
        <header class="tramo__cabecera" data-revelar>
          <p class="etiqueta">WIPs, versiones antiguas, fallos y cuaderno</p>
          <h2 class="tramo__titulo" id="titulo-archivo">Archivo</h2>
        </header>

        <div class="filtros" data-filtros hidden>
          <p class="filtros__grupo" role="group" aria-label="Filtrar por tipo">
            <span class="etiqueta filtros__nombre">Tipo</span>
            <button class="filtro" type="button" data-filtro-tipo="" aria-pressed="true">Todo</button>
            {tipos.map((t) => <button class="filtro" type="button" data-filtro-tipo={t.id} aria-pressed="false">{t.nombre}</button>)}
          </p>
          <p class="filtros__grupo" role="group" aria-label="Filtrar por bloque">
            <span class="etiqueta filtros__nombre">Bloque</span>
            <button class="filtro" type="button" data-filtro-bloque="" aria-pressed="true">Todos</button>
            {bloquesConPiezas.map((b) => <button class="filtro" type="button" data-filtro-bloque={b.numero} aria-pressed="false">{b.numero} · {b.titulo}</button>)}
          </p>
          <p class="filtros__cuenta" aria-live="polite" data-filtros-cuenta></p>
        </div>

        <ul class="coleccion" data-coleccion>
          {piezas.map((p, i) => (
            <li class:list={['coleccion__pieza', `coleccion__pieza--${p.tipo}`]} data-tipo={p.tipo} data-bloque={p.bloque}>
              {p.imagen && <Imagen imagen={p.imagen} ratio={i % 3 === 1 ? '4 / 5' : '16 / 10'} ver grupo={p.grupo} pie={p.titulo} />}
              <p class="etiqueta coleccion__tipo">{nombreTipo[p.tipo]}{p.bloque !== '' && ` · Bloque ${p.bloque}`}</p>
              <h3 class="coleccion__titulo">{p.titulo}</h3>
              {p.texto && <p class="coleccion__texto">{p.texto}</p>}
            </li>
          ))}
          <li class="coleccion__pieza coleccion__pieza--cuaderno" data-tipo="cuaderno" data-bloque="">
            <Imagen imagen={cuaderno.grafo ? { src: cuaderno.grafo, alt: 'Grafo de las notas del proyecto en Obsidian.' } : { src: null, alt: 'Grafo de las notas del proyecto en Obsidian.', falta: 'Captura del grafo de Obsidian del proyecto' }} ratio="16 / 10" ver pie="Grafo del proyecto en Obsidian" />
            <p class="etiqueta coleccion__tipo">Cuaderno</p>
            <h3 class="coleccion__titulo">Grafo del proyecto en Obsidian</h3>
          </li>
          <li class="coleccion__pieza coleccion__pieza--cuaderno coleccion__pieza--notas" data-tipo="cuaderno" data-bloque="">
            <p class="etiqueta coleccion__tipo">Cuaderno</p>
            <h3 class="coleccion__titulo">Notas publicadas</h3>
            {cuaderno.notas.length > 0 ? (
              <ul class="coleccion__notas">
                {cuaderno.notas.map((n) => (
                  <li>{n.enlace ? <a href={n.enlace}>{n.titulo}</a> : n.titulo}<span class="coleccion__nota-tipo">{n.tipo}</span></li>
                ))}
              </ul>
            ) : (
              <p class="coleccion__texto"><span class="insignia">Placeholder</span>Aquí sale el índice de las notas publicadas desde Obsidian (registros semanales y referencias) cuando se ejecute <code>npm run exportar</code>.</p>
            )}
          </li>
        </ul>
      </section>
    </div>
  </div>

  <Siguiente actual="proceso" />
</Base>
