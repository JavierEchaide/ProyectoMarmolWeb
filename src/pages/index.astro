---
import Base from '../layouts/Base.astro';
import Imagen from '../components/Imagen.astro';
import Grieta from '../components/Grieta.astro';
import Greca from '../components/Greca.astro';
import Ojos from '../components/Ojos.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import Siguiente from '../components/Siguiente.astro';
import { portada } from '../data/portada.js';
import { pagina } from '../data/sitio.js';

const romanos = ['I', 'II', 'III', 'IV'];
// Letras agrupadas por palabras: en móvil el título parte entre palabras
let n = 0;
const palabras = portada.intro.titulo.split(' ').map((p) => [...p].map((l) => ({ l, i: n++ })));
const frases = portada.gancho.match(/[^.!?]+[.!?]*/g).map((f) => f.trim());
---
<Base id="portada" scripts={['js/portada.js']}>
  {/* Intro: solo se ve si el <head> ha puesto la clase .intro-activa (recarga o primera entrada) */}
  <div class="intro" aria-hidden="true" data-intro>
    <span class="intro__panel intro__panel--izq"></span>
    <span class="intro__panel intro__panel--der"></span>
    <div class="intro__texto">
      <span class="intro__saludo">{portada.intro.saludo}</span>
      <span class="intro__titulo">
        {palabras.map((letras, j) => (
          <>
            {j > 0 && ' '}
            <span class="intro__palabra">
              {letras.map(({ l, i }) => <span class="intro__letra" style={`--i: ${i}`}>{l}</span>)}
            </span>
          </>
        ))}
      </span>
    </div>
  </div>

  <section class="hero" aria-labelledby="titulo-portada" data-hero style={`--ratio-movil: ${portada.hero.ratioMovil}`}>
    <h1 id="titulo-portada" class="oculto">{portada.hero.titulo}</h1>
    <div class="hero__imagen" data-hero-imagen>
      {portada.hero.video ? (
        <video
          class="hero__video"
          src={portada.hero.video}
          poster={portada.hero.escritorio}
          autoplay
          muted
          loop
          playsinline
          aria-label={portada.hero.alt}
          data-hero-video
        ></video>
      ) : portada.hero.capas.length ? (
        portada.hero.capas.map((c, i) => (
          <img
            class="hero__capa"
            src={c.src}
            alt={i === 0 ? portada.hero.alt : ''}
            data-profundidad={c.profundidad}
            decoding="async"
          />
        ))
      ) : (
        <picture>
          <source media="(max-width: 700px)" srcset={portada.hero.movil} />
          <img src={portada.hero.escritorio} alt={portada.hero.alt} fetchpriority="high" decoding="async" />
        </picture>
      )}
    </div>
    <span class="hero__pista" aria-hidden="true"></span>
  </section>

  <section class="contenedor presentacion" aria-label="Presentación">
    <p class="presentacion__gancho" data-revelar>
      {frases.map((f) => <span class="presentacion__frase">{f}</span>)}
    </p>
    <div class="presentacion__texto" data-revelar>
      {portada.presentacion.map((p) => <p>{p}</p>)}
      <a class="boton" href="teaser.html">
        <span>Entrar</span>
        <svg class="flecha" viewBox="0 0 24 12" aria-hidden="true"><path d="M1 6h22M18 1l5 5-5 5" /></svg>
      </a>
    </div>
  </section>

  <Grieta semilla={3} />

  <section class="contenedor seccion" aria-labelledby="titulo-prologo">
    <TituloSeccion titulo="La historia en cuatro fotogramas" id="titulo-prologo" />
    <ol class="fotogramas">
      {portada.fotogramas.map((f, i) => (
        <li class="fotograma" data-revelar style={`--i: ${i}`}>
          {f.ojos && !f.imagen.src ? (
            <Ojos alt={f.imagen.alt} />
          ) : (
            <Imagen imagen={f.imagen} ratio="16 / 9" ver grupo="prologo" pie={`${romanos[i]}. ${f.pie}`} />
          )}
          <p class="fotograma__pie"><span class="fotograma__numero">{romanos[i]}</span>{f.pie}</p>
        </li>
      ))}
    </ol>
  </section>

  <Grieta semilla={8} />

  {/* Las páginas: cartas que flotan en 3D sobre la sala oscura (referencia:
      karma-tracks). El balanceo es CSS; el ratón las mueve por capas (js/portada.js). */}
  <section class="sala-cartas" aria-labelledby="titulo-paginas">
    <div class="contenedor">
      <TituloSeccion titulo="Las páginas" id="titulo-paginas" />
      <ul class="cartas" data-cartas>
        {portada.accesos.map((a, i) => {
          const p = pagina(a.pagina);
          return (
            <li class="carta" style={`--i: ${i}`} data-carta>
              <a class={`carta__cara carta__cara--${a.piedra}`} href={p.archivo}>
                <span class="carta__textura" aria-hidden="true"></span>
                {a.imagen.src && <img class="carta__imagen" src={a.imagen.src} alt="" loading="lazy" decoding="async" />}
                <span class="carta__marco" aria-hidden="true">
                  <span class="esquina esquina--a"></span>
                  <span class="esquina esquina--b"></span>
                  <span class="esquina esquina--c"></span>
                  <span class="esquina esquina--d"></span>
                </span>
                <span class="carta__sala">Sala {p.numero}</span>
                <span class="carta__dato">{a.subtitulo}</span>
                <span class="carta__texto">
                  <h3 class="carta__titulo">{p.titulo}</h3>
                  <span class="carta__frase">{a.frase}</span>
                </span>
                <span class="carta__entrar">
                  Entrar
                  <svg class="flecha" viewBox="0 0 24 12" aria-hidden="true"><path d="M1 6h22M18 1l5 5-5 5" /></svg>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {/* Hecho por: escena fijada mientras se baja; el busto 3D (js/busto.js) se
      abre y deja ver el hueso. Sin WebGL se ve la imagen de respaldo. */}
  <section
    class="vitrina"
    aria-labelledby="titulo-autor"
    data-busto
    data-busto-modelo={portada.autor.modelo ?? undefined}
  >
    <div class="vitrina__escena">
      <h2 id="titulo-autor" class="vitrina__nombre">
        {portada.autor.nombre.split(' ').map((p) => <span class="vitrina__palabra">{p}</span>)}
      </h2>
      <canvas class="vitrina__lienzo" data-busto-lienzo aria-hidden="true"></canvas>
      <div class="vitrina__respaldo">
        <Imagen imagen={portada.autor.imagen} ratio="3 / 4" oscuro ver pie={portada.autor.nombre} />
      </div>
      <div class="vitrina__cartela">
        <p class="vitrina__etiqueta">{portada.autor.etiqueta}</p>
        <Greca ancho={96} />
        <p>{portada.autor.estudios}</p>
        <p class="vitrina__curso">{portada.autor.curso}</p>
      </div>
      <p class="vitrina__pista" aria-hidden="true">Baja para abrirla</p>
    </div>
  </section>

  <Siguiente actual="portada" />
</Base>
