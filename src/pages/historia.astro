---
import Base from '../layouts/Base.astro';
import Imagen from '../components/Imagen.astro';
import Tarjeta from '../components/Tarjeta.astro';
import Grieta from '../components/Grieta.astro';
import Spoiler from '../components/Spoiler.astro';
import TituloSeccion from '../components/TituloSeccion.astro';
import { pagina } from '../data/sitio.js';
import Siguiente from '../components/Siguiente.astro';
import { historia } from '../data/historia.js';

const { premisa, partes, final } = historia;
const tapadas = partes.filter((p) => p.spoiler).map((p) => p.numero);
---
<Base id="historia" descripcion="Resumen de la historia de Serie Mármol, con los spoilers tapados." scripts={['js/historia.js']}>
  {/* Cabecera de mármol: el cursor abre una grieta-ventana a otro mundo (js/historia.js) */}
  <header class="ventana" data-ventana>
    <div class="ventana__mundo" data-ventana-mundo aria-hidden="true">
      {historia.ventana.src ? (
        <img src={historia.ventana.src} alt="" decoding="async" />
      ) : (
        <span class="ventana__falta">{historia.ventana.falta}</span>
      )}
    </div>
    <svg class="ventana__borde" data-ventana-borde aria-hidden="true" focusable="false"><path /></svg>
    <div class="contenedor ventana__pie">
      <div class="ventana__cartela">
        <TituloSeccion titulo="Historia" nivel={1} numero={pagina('historia').numero} />
        <p class="ventana__lema">Las criaturas no nacen: se tallan.</p>
        <p class="ventana__pista">Pasa el cursor por el mármol: detrás hay otros mundos.</p>
      </div>
    </div>
  </header>

  <section class="contenedor premisa" aria-labelledby="titulo-premisa">
    <div class="premisa__texto" data-revelar>
      <h2 id="titulo-premisa" class="antetitulo">{premisa.titulo}</h2>
      {premisa.parrafos.map((p, i) => <p class:list={{ premisa__entrada: i === 0 }}>{p}</p>)}
    </div>
    <div class="premisa__imagen" data-revelar>
      <Imagen imagen={premisa.imagen} ratio="4 / 5" ver pie={premisa.imagen.alt} />
    </div>
  </section>

  <Grieta semilla={21} />

  <section class="contenedor seccion" aria-labelledby="titulo-partes">
    <TituloSeccion titulo="Las seis partes" id="titulo-partes">
      <div class="aviso-spoiler">
        <p>Las partes {tapadas.join(', ').replace(/, ([^,]*)$/, ' y $1')} y el final están tapados. Pulsa un cartel para descubrirlo.</p>
        <button class="boton boton--pequeno" type="button" data-spoiler-todos aria-pressed="false">Mostrar todos</button>
      </div>
    </TituloSeccion>

    {/* El arco de la serie, sin texto: las partes cuelgan a ambos lados de una
        veta que con el scroll pasa de intacta (I-II) a grieta oscura (III-IV)
        y a grieta rellena de oro (V-VI). js/historia.js */}
    <div class="arco" data-arco>
      <svg class="arco__veta" data-arco-veta aria-hidden="true" focusable="false"></svg>
    <ol class="partes partes--arco">
      {partes.map((p, i) => (
        <Tarjeta etiqueta="li" clase={`parte parte--${i < 2 ? 'pura' : i < 4 ? 'rota' : 'oro'}`}>
          <span class="parte__nodo" aria-hidden="true"><span>{p.numero}</span></span>
          <p class="parte__numero">Parte {p.numero}</p>
          <Spoiler activo={p.spoiler} semilla={40 + i} descripcion={`la parte ${p.numero}`}>
            <Imagen imagen={p.imagen} ratio="4 / 3" ver={!p.spoiler} grupo="partes" pie={`Parte ${p.numero}. ${p.titulo}`} />
            <h3 class="parte__titulo">{p.titulo}</h3>
            <p class="parte__texto">{p.texto}</p>
          </Spoiler>
        </Tarjeta>
      ))}
    </ol>
    </div>
  </section>

  <section class="contenedor seccion final" aria-labelledby="titulo-final">
    <TituloSeccion titulo={final.titulo} id="titulo-final" />
    <Spoiler semilla={77} texto="Spoiler · El final" descripcion="el final">
      <div class="final__cuerpo">
        {final.parrafos.map((p) => <p>{p}</p>)}
        <blockquote class="final__cita"><p>{final.cita}</p></blockquote>
      </div>
    </Spoiler>
  </section>

  <Siguiente actual="historia" />
</Base>
