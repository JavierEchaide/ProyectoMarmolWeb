---
// Tapa el contenido con una losa de piedra negra que pone SPOILER. Al
// pulsarla se agrieta en oro y se rompe en esquirlas (js/historia.js).
// Mientras está tapado, el contenido es `inert` (no se lee ni se enfoca) y el
// bloque se queda a una altura fija; al destaparse crece hasta su tamaño real.
// Con `activo={false}` no tapa nada.
const { activo = true, semilla = 1, texto = 'Spoiler', descripcion = 'contenido' } = Astro.props;
---
<div class:list={['spoiler', { 'spoiler--activo': activo }]} data-spoiler={activo ? 'tapado' : undefined} data-semilla={semilla}>
  <div class="spoiler__contenido" inert={activo}>
    <slot />
  </div>
  {activo && (
    <button class="spoiler__tapa" type="button" aria-label={`${texto}: pulsa para descubrir ${descripcion}`} data-spoiler-tapa>
      <span class="spoiler__luz" aria-hidden="true"></span>
      <span class="spoiler__cara" aria-hidden="true">
        <svg class="spoiler__grietas" focusable="false"></svg>
        <span class="spoiler__texto">{texto}</span>
        <span class="spoiler__ayuda">Pulsa para descubrirlo</span>
      </span>
    </button>
  )}
</div>
