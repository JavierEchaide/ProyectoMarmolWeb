---
// Tapa el contenido (imagen y texto juntos) con una losa de piedra negra que
// pone SPOILER. Al pulsarla se agrieta en oro y se rompe en esquirlas
// (js/historia.js). Mientras está tapado, el contenido es `inert` (no se lee
// ni se enfoca) y el bloque se queda a una altura fija; al destaparse crece
// hasta su tamaño real. No se puede volver a tapar. Con `activo={false}` no
// tapa nada.
// El nombre accesible del botón es su texto visible (`texto` + `ayuda`).
const { activo = true, semilla = 1, texto = 'Spoiler', ayuda = 'Pulsa para descubrirlo' } = Astro.props;
---
<div class:list={['spoiler', { 'spoiler--activo': activo }]} data-spoiler={activo ? 'tapado' : undefined} data-semilla={semilla}>
  <div class="spoiler__contenido" inert={activo}>
    <slot />
  </div>
  {activo && (
    <button class="spoiler__tapa" type="button" data-spoiler-tapa>
      <span class="spoiler__luz" aria-hidden="true"></span>
      <span class="spoiler__cara">
        <svg class="spoiler__grietas" aria-hidden="true" focusable="false"></svg>
        <span class="spoiler__texto">{texto}</span>
        <span class="spoiler__ayuda">{ayuda}</span>
      </span>
    </button>
  )}
</div>
