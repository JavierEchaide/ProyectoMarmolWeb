---
// "Nunca bajó a mirar": los ojos del Creador (plano 2) apartan la mirada del
// cursor; si el cursor se queda quieto un rato, por fin miran. Al moverlo,
// parpadean y vuelven a esquivarlo (js/portada.js). Dibujados en oro sobre
// piedra mientras no llegue el render del plano.
const { alt = '', ratio = '16 / 9' } = Astro.props;
const ojos = [
  { cx: 104, cy: 92 },
  { cx: 216, cy: 92 },
];
---
<div class="ojos" style={`aspect-ratio: ${ratio}`} role="img" aria-label={alt} data-ojos>
  <svg viewBox="0 0 320 180" aria-hidden="true" focusable="false">
    <defs>
      {ojos.map((o, i) => (
        <clipPath id={`ojo-recorte-${i}`}>
          <path d={`M${o.cx - 46} ${o.cy} Q${o.cx} ${o.cy - 34} ${o.cx + 46} ${o.cy} Q${o.cx} ${o.cy + 30} ${o.cx - 46} ${o.cy} Z`} />
        </clipPath>
      ))}
      <radialGradient id="ojo-iris" cx="50%" cy="45%" r="55%">
        <stop offset="0" stop-color="#8a6a2a" />
        <stop offset="0.55" stop-color="#5a4220" />
        <stop offset="1" stop-color="#21170c" />
      </radialGradient>
    </defs>
    {ojos.map((o, i) => (
      <g class="ojo" data-ojo data-cx={o.cx} data-cy={o.cy}>
        {/* ceja: un trazo grabado */}
        <path class="ojo__ceja" d={`M${o.cx - 50} ${o.cy - 30} Q${o.cx} ${o.cy - 52} ${o.cx + 52} ${o.cy - 28}`} />
        <g class="ojo__globo">
          <g clip-path={`url(#ojo-recorte-${i})`}>
            <rect class="ojo__blanco" x={o.cx - 50} y={o.cy - 36} width="100" height="72" />
            <g class="ojo__iris" data-iris>
              <circle cx={o.cx} cy={o.cy} r="17" fill="url(#ojo-iris)" />
              <circle class="ojo__aro" cx={o.cx} cy={o.cy} r="17" />
              <circle class="ojo__pupila" cx={o.cx} cy={o.cy} r="7" data-pupila />
              <circle class="ojo__brillo" cx={o.cx - 5} cy={o.cy - 6} r="2.6" />
            </g>
            {/* sombra del párpado superior */}
            <path class="ojo__sombra" d={`M${o.cx - 50} ${o.cy - 36} H${o.cx + 50} V${o.cy - 14} Q${o.cx} ${o.cy - 30} ${o.cx - 50} ${o.cy - 8} Z`} />
          </g>
          <path class="ojo__contorno" d={`M${o.cx - 46} ${o.cy} Q${o.cx} ${o.cy - 34} ${o.cx + 46} ${o.cy} Q${o.cx} ${o.cy + 30} ${o.cx - 46} ${o.cy} Z`} />
        </g>
      </g>
    ))}
  </svg>
</div>
