---
// Banda de greca (meandro griego) dorada. Usa el patrón #greca definido una
// sola vez en el Layout. `ancho` en px; con 'total' ocupa todo el ancho.
const { ancho = 120, clase = '' } = Astro.props;
const total = ancho === 'total';
---
<svg
  class:list={['greca', clase, { 'greca--total': total }]}
  width={total ? '100%' : ancho}
  height="14"
  aria-hidden="true"
  focusable="false"
>
  <rect width="100%" height="14" fill="url(#greca)" />
</svg>
